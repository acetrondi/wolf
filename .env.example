# App (required)
NODE_ENV=development
APP_URL=http://localhost:3000

# Neon (required) — pooled URL for app queries
DATABASE_URL=

# Neon (optional for now) — direct URL for migrations later
DATABASE_URL_MIGRATOR=

# Clerk (required)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk (optional until webhooks)
CLERK_WEBHOOK_SECRET=

# OpenRouter (required)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.6-flash

# Optional until later phases
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODE=live

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

RESEND_API_KEY=
EMAIL_FROM=

TRIGGER_SECRET_KEY=
ENCRYPTION_KEY=
